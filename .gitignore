# 1. Ficheiros Compilados (O Git ignora o resultado, guarda apenas a origem)
*.class
out/
bin/

# 2. Ficheiros de Log e Crash da JVM
*.log
hs_err_pid*
replay_pid*

# 3. Empacotamentos e Binários
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# 4. Configurações Específicas de IDEs (IntelliJ, Eclipse, VS Code)
# Cada programador tem a sua IDE, estas configurações não devem ser partilhadas
.idea/
*.iml
*.iws
.settings/
.metadata/
.classpath
.project
.vscode/

# 5. Ficheiros do Sistema Operativo (Mac e Windows)
.DS_Store
Thumbs.db

# 6. Pastas de Build Automation (Maven/Gradle - caso venhamos a utilizar na Aula 3)
target/
build/
.gradle/